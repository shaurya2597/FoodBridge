# ---- Backend (copy to backend/.env) ----
DATABASE_URL="postgresql://postgres:replace-with-your-local-db-password@localhost:5432/foodbridge?schema=public"
PORT=5000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"   # comma-separate multiple origins
TRUST_PROXY=0                         # set to 1 only when behind one reverse proxy

# Pricing
TAX_RATE_PERCENT=5
PLATFORM_FEE=5                 # rupees
ENFORCE_OPENING_HOURS=false    # true = refuse orders outside the restaurant's opening hours (India time)
# ALLOW_DEMO_PAYMENTS=true     # defaults to true outside production

# Optional: services fall back to DEMO mode when these are empty
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=               # rzp_test_... only. rzp_live_ keys are rejected at startup
RAZORPAY_KEY_SECRET=
# Password-reset email. Leave empty for DEMO mode (the reset link is printed in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FoodBridge <no-reply@foodbridge.local>"
# DEMO ONLY: also return the reset token in the API response. Refused when NODE_ENV=production.
# DEMO_RETURN_RESET_TOKEN=true

# Seed passwords (used only by prisma/seed.ts)
SEED_DEMO_PASSWORD="replace-with-your-own-unique-password"

# ---- Frontend (copy to frontend/.env) ----
# VITE_API_URL=http://localhost:5000/api

# ---- Integration tests only (a SEPARATE, throwaway database; never your dev DB) ----
# TEST_DATABASE_URL="postgresql://postgres:replace-with-your-local-db-password@localhost:5432/foodbridge_test?schema=public"
